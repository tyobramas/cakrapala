# Cakrapala Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials.

# 1. NASA JPL API Key (from https://api.nasa.gov/)
# Server-side only (never exposed to client browser)
# If left blank or DEMO_KEY, standard rate-limits apply (30 req/hour, 50 req/day).
NASA_API_KEY=your_nasa_api_key_here

# 2. Cesium Ion Access Token (from https://ion.cesium.com/tokens)
# Used for high-resolution satellite imagery and terrain.
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_cesium_token_here

# 3. Nara Router LLM Configuration (Cakrapala AI Astronomy Agent)
# Server-side only (never exposed to client browser)
NARA_ROUTER_BASE_URL=https://router.bynara.id/v1
NARA_ROUTER_API_KEY=your_nara_api_key_here
NARA_ROUTER_MODEL=agnes-2.5-flash
